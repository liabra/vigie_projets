# Clé API Anthropic — obligatoire pour le copilote.
# À créer sur https://console.anthropic.com (le compte doit avoir des crédits).
# Ne commite JAMAIS la vraie clé : sur Railway, mets-la dans Variables.
ANTHROPIC_API_KEY=sk-ant-...

# Modèle de repli quand le client n'en demande aucun (optionnel).
# Par défaut : claude-haiku-4-5-20251001, le moins cher. Le menu de l'app
# choisit au cas par cas, dans la limite de la liste blanche du serveur.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Base PostgreSQL (fournie automatiquement par Railway).
# Si absente, projets et tâches sont gardés en mémoire — remis à zéro à
# chaque redémarrage : pratique en local, inutilisable en production.
# DATABASE_URL=postgresql://user:password@host:5432/railway

# Code d'accès (optionnel). S'il est défini, l'app le demande à l'ouverture
# et /api/projects, /api/tasks comme /api/ask exigent l'en-tête x-app-key.
# APP_PASSWORD=un-code-a-toi

# ── Agenda Google (optionnel) ────────────────────────────────
# Sans ces trois variables, les tâches fonctionnent normalement :
# seule la synchro vers l'agenda reste en sommeil.
# Console : https://console.cloud.google.com — API Google Calendar
# activée, identifiant OAuth de type « Application Web ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit être IDENTIQUE à l'URI de redirection autorisée côté Google.
# En production : https://<ton-domaine-railway>/oauth/callback
GOOGLE_REDIRECT_URI=
